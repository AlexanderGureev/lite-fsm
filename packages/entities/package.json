{
  "name": "@lite-fsm/entities",
  "version": "0.1.0",
  "type": "module",
  "description": "Alpha entity runtime plugin for lite-fsm",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "examples",
    "PERFORMANCE.md"
  ],
  "keywords": [
    "lite-fsm",
    "fsm",
    "finite-state-machine",
    "entity-runtime",
    "state-management",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderGureev/lite-fsm.git",
    "directory": "packages/entities"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc -p tsconfig.build.json && node ../../scripts/dts-to-dcts.mjs dist",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lite-fsm/core": "workspace:*"
  },
  "devDependencies": {
    "@lite-fsm/react": "workspace:*"
  },
  "peerDependencies": {
    "@lite-fsm/react": "workspace:*",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@lite-fsm/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
